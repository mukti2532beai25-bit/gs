// BahiVerse AI — Production Database Schema
// Target Database: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// 1. Business Profile & Tenancy
// ─────────────────────────────────────────────
model Business {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(150)
  gstin        String?   @db.VarChar(15)
  address      String?   @db.Text
  phone        String?   @db.VarChar(20)
  email        String?   @db.VarChar(120)
  language     String    @default("hi") @db.VarChar(10) // en | hi | pa
  currency     String    @default("INR") @db.VarChar(10)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  users        User[]
  bills        Bill[]
  customers    Customer[]
  products     Product[]
  vocabulary   VocabularyMapping[]
  exports      ExportRecord[]

  @@index([gstin])
}

// ─────────────────────────────────────────────
// Store Staff & Owner Authentication
// ─────────────────────────────────────────────
model User {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String?   @db.Uuid
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(120)
  passwordHash String    @db.VarChar(255)
  role         String    @default("owner") @db.VarChar(20) // owner | staff
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  bills        Bill[]
  corrections  Correction[]
  exports      ExportRecord[]

  @@index([businessId])
}

// ─────────────────────────────────────────────
// 2. Customer Directory
// ─────────────────────────────────────────────
model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @db.Uuid
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String    @db.VarChar(150)
  phone        String?   @db.VarChar(20)
  address      String?   @db.Text
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  bills        Bill[]

  @@index([businessId, name])
  @@index([businessId, phone])
}

// ─────────────────────────────────────────────
// 3. Product Catalog
// ─────────────────────────────────────────────
model Product {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @db.Uuid
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String    @db.VarChar(150)
  aliases      String    @default("[]") @db.Text // JSON array of slang/regional names
  unit         String    @default("piece") @db.VarChar(20) // piece | kg | litre | dozen
  defaultPrice Decimal?  @db.Decimal(12, 2)
  category     String?   @db.VarChar(60)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  billItems    BillItem[]

  @@index([businessId, name])
}

// ─────────────────────────────────────────────
// 4. Bill (Invoice / Handwritten Receipt)
// ─────────────────────────────────────────────
model Bill {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String    @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id])
  customerId    String?   @db.Uuid
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  imageUrl      String?   @db.Text
  captureMode   String    @default("upload") @db.VarChar(20) // upload | camera | voice | manual
  rawText       String?   @db.Text
  language      String    @default("hi") @db.VarChar(10)

  billNumber    String?   @db.VarChar(60)
  billDate      String?   @db.VarChar(30)
  vendorName    String?   @db.VarChar(150)
  vendorPhone   String?   @db.VarChar(20)

  subtotal      Decimal?  @db.Decimal(12, 2)
  taxAmount     Decimal?  @db.Decimal(12, 2)
  totalAmount   Decimal?  @db.Decimal(12, 2)
  notes         String?   @db.Text

  status        String    @default("pending") @db.VarChar(20) // pending | extracted | reviewed | approved | exported
  confidence    Float     @default(0.0)
  processingMs  Int       @default(0)

  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  items         BillItem[]
  corrections   Correction[]
  processingJob ProcessingJob?

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

// ─────────────────────────────────────────────
// 5. BillItem (Preserved Historical Transactions)
// ─────────────────────────────────────────────
model BillItem {
  id             String    @id @default(uuid()) @db.Uuid
  billId         String    @db.Uuid
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId      String?   @db.Uuid
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  rawDescription String    @db.Text
  normalizedName String?   @db.VarChar(150)
  quantity       Decimal   @default(1.0) @db.Decimal(10, 3)
  unit           String?   @db.VarChar(20)
  unitPrice      Decimal?  @db.Decimal(12, 2)
  totalPrice     Decimal?  @db.Decimal(12, 2)
  confidence     Float     @default(0.0)
  isEdited       Boolean   @default(false)

  @@index([billId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// 6. VocabularyMapping (Shop Slang Lexicon)
// ─────────────────────────────────────────────
model VocabularyMapping {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @db.Uuid
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rawTerm        String    @db.VarChar(100)
  normalizedTerm String    @db.VarChar(150)
  category       String    @default("product") @db.VarChar(30) // product | unit | customer | misc
  language       String    @default("hi") @db.VarChar(10)
  usageCount     Int       @default(0)
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  @@unique([businessId, rawTerm])
  @@index([businessId, category])
}

// ─────────────────────────────────────────────
// 7. Correction (Audit Trail)
// ─────────────────────────────────────────────
model Correction {
  id             String    @id @default(uuid()) @db.Uuid
  billId         String    @db.Uuid
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id])
  fieldName      String    @db.VarChar(60)
  originalValue  String?   @db.Text
  correctedValue String    @db.Text
  source         String    @default("manual") @db.VarChar(20) // manual | voice
  createdAt      DateTime  @default(now()) @db.Timestamptz

  @@index([billId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// 8. ProcessingJob (AI Extraction Pipeline Tracker)
// ─────────────────────────────────────────────
model ProcessingJob {
  id           String    @id @default(uuid()) @db.Uuid
  billId       String    @unique @db.Uuid
  bill         Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  status       String    @default("queued") @db.VarChar(20) // queued | processing | done | failed
  provider     String    @default("demo") @db.VarChar(30) // demo | openai | google-vision
  errorMessage String?   @db.Text
  startedAt    DateTime? @db.Timestamptz
  completedAt  DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz

  @@index([status])
}

// ─────────────────────────────────────────────
// Export Record (CSV / JSON / Tally XML Logs)
// ─────────────────────────────────────────────
model ExportRecord {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  format     String    @db.VarChar(20) // csv | json | tally-xml
  fileName   String    @db.VarChar(255)
  fileUrl    String?   @db.Text
  billCount  Int       @default(0)
  dateFrom   DateTime? @db.Timestamptz
  dateTo     DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([businessId])
  @@index([userId])
}
