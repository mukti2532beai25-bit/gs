# ────────────────────────────────────────────────────────────────
# BahiVerse AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────
# Database URL (PostgreSQL via Docker or local instance):
DATABASE_URL="postgresql://bahiverse:bahiverse_dev_password@localhost:5432/bahiverse_db?schema=public"

# ── Authentication ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="bahiverse_dev_secret_change_this_in_production"
JWT_EXPIRES_IN="7d"

# ── File Uploads ──────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10

# ── AI / OCR Provider ────────────────────────────────────────────
# Leave blank to use demo/local fallback mode.
# Supported providers: openai | google-vision | tesseract-local
OCR_PROVIDER=demo

# OpenAI (for GPT-4o vision extraction)
OPENAI_API_KEY=

# Google Cloud Vision
GOOGLE_CLOUD_KEY_FILE=

# ── Voice / Speech ────────────────────────────────────────────────
# Supported: browser | whisper-api | demo
VOICE_PROVIDER=browser

WHISPER_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001
VITE_APP_NAME="BahiVerse AI"
VITE_OCR_DEMO_MODE=true
