// BahiVerse AI — Prisma Schema
// Dev: SQLite | Prod: PostgreSQL (change provider + DATABASE_URL)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// Business Profile
// ─────────────────────────────────────────────
model Business {
  id           String    @id @default(uuid())
  name         String
  gstin        String?
  address      String?
  phone        String?
  email        String?
  logoUrl      String?
  language     String    @default("en") // en | hi | pa
  currency     String    @default("INR")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users        User[]
  bills        Bill[]
  customers    Customer[]
  products     Product[]
  vocabulary   VocabularyMapping[]
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────
model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("owner") // owner | staff
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bills        Bill[]
  exports      ExportRecord[]
  corrections  Correction[]
}

// ─────────────────────────────────────────────
// Customer
// ─────────────────────────────────────────────
model Customer {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bills        Bill[]

  @@index([businessId])
}

// ─────────────────────────────────────────────
// Product / Catalog Item
// ─────────────────────────────────────────────
model Product {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  aliases      String    @default("[]") // JSON array of alternative names
  unit         String    @default("piece") // piece | kg | litre | dozen
  defaultPrice Float?
  category     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  billItems    BillItem[]

  @@index([businessId])
}

// ─────────────────────────────────────────────
// Bill (Captured Receipt / Invoice)
// ─────────────────────────────────────────────
model Bill {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Capture metadata
  imageUrl      String?
  captureMode   String    @default("upload") // upload | camera | voice
  rawText       String?   // raw OCR output
  language      String    @default("en")

  // Extracted fields (top-level summary)
  billNumber    String?
  billDate      String?   // stored as string to preserve original format
  vendorName    String?
  vendorPhone   String?
  subtotal      Float?
  taxAmount     Float?
  totalAmount   Float?
  notes         String?

  // Status workflow
  status        String    @default("pending") // pending | extracted | reviewed | approved | exported

  // Processing
  confidence    Float     @default(0.0) // 0-1 overall extraction confidence
  processingMs  Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         BillItem[]
  corrections   Correction[]
  processingJob ProcessingJob?
  exportItems   ExportBillItem[]

  @@index([businessId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Bill Line Items
// ─────────────────────────────────────────────
model BillItem {
  id            String    @id @default(uuid())
  billId        String
  bill          Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  rawDescription String   // original text as captured — immutable
  normalizedName String?  // matched/normalized product name
  quantity      Float     @default(1)
  unit          String?
  unitPrice     Float?    // historical price — preserved even if product price changes
  totalPrice    Float?
  confidence    Float     @default(0.0)
  isEdited      Boolean   @default(false) // human-corrected

  @@index([billId])
}

// ─────────────────────────────────────────────
// Vocabulary Mapping (Shop-specific terms)
// ─────────────────────────────────────────────
model VocabularyMapping {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rawTerm       String    // local/dialect term e.g. "doodh"
  normalizedTerm String   // standard term e.g. "milk"
  category      String    @default("product") // product | unit | customer | misc
  language      String    @default("hi") // hi | pa | en
  usageCount    Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([businessId, rawTerm])
  @@index([businessId])
}

// ─────────────────────────────────────────────
// Correction (Human edits on extracted data)
// ─────────────────────────────────────────────
model Correction {
  id           String    @id @default(uuid())
  billId       String
  bill         Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  fieldName    String    // which field was corrected
  originalValue String?
  correctedValue String
  source       String    @default("manual") // manual | voice
  createdAt    DateTime  @default(now())

  @@index([billId])
}

// ─────────────────────────────────────────────
// Processing Job (Async OCR/AI tracking)
// ─────────────────────────────────────────────
model ProcessingJob {
  id           String    @id @default(uuid())
  billId       String    @unique
  bill         Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  status       String    @default("queued") // queued | processing | done | failed
  provider     String    @default("demo") // demo | openai | google-vision
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
}

// ─────────────────────────────────────────────
// Export Record
// ─────────────────────────────────────────────
model ExportRecord {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  format       String    // csv | json | pdf | tally-xml
  fileName     String
  fileUrl      String?
  billCount    Int       @default(0)
  dateFrom     DateTime?
  dateTo       DateTime?
  createdAt    DateTime  @default(now())

  bills        ExportBillItem[]
}

// Junction: which bills are in an export
model ExportBillItem {
  exportId     String
  export       ExportRecord @relation(fields: [exportId], references: [id], onDelete: Cascade)
  billId       String
  bill         Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@id([exportId, billId])
}
